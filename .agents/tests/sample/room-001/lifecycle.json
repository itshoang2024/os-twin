{
  "version": 2,
  "initial_state": "developing",
  "max_retries": 3,
  "states": {
    "developing": {
      "role": "engineer",
      "type": "work",
      "signals": {
        "done": {
          "target": "review"
        }
      }
    },
    "optimize": {
      "role": "engineer",
      "type": "work",
      "signals": {
        "done": {
          "target": "review"
        }
      }
    },
    "review": {
      "role": "qa",
      "type": "review",
      "signals": {
        "done": {
          "target": "done"
        },
        "pass": {
          "target": "done"
        },
        "fail": {
          "target": "triage"
        },
        "escalate": {
          "target": "triage"
        }
      }
    },
    "triage": {
      "role": "manager",
      "type": "triage",
      "signals": {
        "fix": {
          "target": "optimize",
          "actions": [
            "increment_retries"
          ]
        },
        "redesign": {
          "target": "developing",
          "actions": [
            "increment_retries",
            "revise_brief"
          ]
        },
        "reject": {
          "target": "failed"
        }
      }
    },
    "failed": {
      "type": "terminal"
    },
    "done": {
      "type": "terminal"
    }
  }
}
