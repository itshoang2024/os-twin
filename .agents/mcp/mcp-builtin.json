{
  "mcp": {
    "channel": {
      "type": "local",
      "command": [
        "{env:OSTWIN_PYTHON}",
        "{env:AGENT_DIR}/mcp/channel-server.py"
      ],
      "environment": {
        "AGENT_OS_ROOT": "."
      }
    },
    "warroom": {
      "type": "local",
      "command": [
        "{env:OSTWIN_PYTHON}",
        "{env:AGENT_DIR}/mcp/warroom-server.py"
      ],
      "environment": {
        "AGENT_OS_ROOT": "."
      }
    },
    "memory": {
      "type": "remote",
      "url": "http://localhost:3366/api/memory-pool/mcp",
      "headers": {
        "Authorization": "Bearer {env:OSTWIN_API_KEY}"
      }
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "obscura",
        "mcp"
      ],
      "environment": {
        "PATH": "{env:PATH}"
      }
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ],
      "environment": {
        "PATH": "{env:PATH}"
      }
    },
    "knowledge": {
      "type": "remote",
      "url": "http://localhost:3366/api/knowledge/mcp/",
      "headers": {
        "Authorization": "Bearer {env:OSTWIN_API_KEY}"
      }
    },
    "codegraph": {
      "type": "local",
      "command": [
        "npx",
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    }
  }
}